# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB Atlas (usuario con permisos solo sobre esta base de datos)
DATABASE_URL="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<basedatos>?retryWrites=true&w=majority"

# Frontend
# Orígenes permitidos por CORS, separados por comas (en local el proxy de Vite evita CORS).
CLIENT_ORIGIN=http://localhost:5173
# URL pública del frontend
APP_URL=http://localhost:5173

# Sesión: genera uno con  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<cadena-aleatoria-de-al-menos-32-caracteres>
JWT_EXPIRES_IN=7d
# Nº de proxies delante de la API: 0 en local, 2 con Vercel (rewrite) -> Railway
TRUST_PROXY=0

# Claude
ANTHROPIC_API_KEY=<tu-api-key-de-anthropic>
CLAUDE_MODEL_INSIGHTS=claude-opus-5-5
# Para abaratar la categorización a escala puedes probar claude-haiku-5-5 (decisión tuya)
CLAUDE_MODEL_CATEGORIZE=claude-opus-5-5

# Tink (consola de Tink -> tu app). La redirect URI debe estar registrada allí.
TINK_CLIENT_ID=<tink-client-id>
TINK_CLIENT_SECRET=<tink-client-secret>
TINK_REDIRECT_URI=http://localhost:5173/bank/callback
TINK_MARKET=ES
TINK_LOCALE=es_ES
# true = Tink Link muestra los bancos de prueba (Demo Bank)
TINK_TEST_MODE=true

# Enable Banking (bancos reales vía PSD2, p. ej. imagin). Ver docs/DEPLOY.md.
ENABLE_BANKING_APP_ID=<id-de-la-app>
# En local: ruta al .pem descargado (la carpeta secrets/ está en .gitignore)
ENABLE_BANKING_KEY_PATH=secrets/<id-de-la-app>.pem
# En despliegue, en lugar de la ruta: el contenido del .pem con los saltos de línea como 

# ENABLE_BANKING_PRIVATE_KEY=
# Debe estar registrada en la app de Enable Banking (exige https)
ENABLE_BANKING_REDIRECT_URI=https://localhost:5173/bank/callback
ENABLE_BANKING_COUNTRY=ES

# Cuota del plan FREE
FREE_MONTHLY_EXPENSES=50
