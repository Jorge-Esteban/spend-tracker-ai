{
  "name": "spend-tracker-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Control de gastos multiusuario con categorización e insights de Claude e importación bancaria vía Tink",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "claim-orphans": "node scripts/claim-orphans.js",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prisma": "~6.19.3",
    "supertest": "^7.3.1",
    "vitest": "3.2"
  }
}
