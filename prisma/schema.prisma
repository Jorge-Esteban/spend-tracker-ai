// Spend Tracker AI v2 — esquema MongoDB (Prisma 6.19.x; Prisma 7 aún no soporta MongoDB).
// Regla de oro: todo dato de negocio cuelga de un userId y toda consulta filtra por él.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

// Un movimiento es un gasto o un ingreso; las categorías también tienen tipo.
enum EntryKind {
  EXPENSE
  INCOME
}

enum ExpenseSource {
  MANUAL
  BANK
}

enum CategorizedBy {
  USER
  RULE
  AI
  FALLBACK
}

enum InsightKind {
  INSIGHTS
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories    Category[]
  expenses      Expense[]
  merchantRules MerchantRule[]
  insights      AiInsight[]
  usage         UsageCounter[]

  @@map("users")
}

model Category {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @db.ObjectId
  name               String
  color              String    @default("#94a3b8")
  icon               String    @default("🏷️")
  kind               EntryKind @default(EXPENSE)
  // Presupuesto mensual en céntimos (solo categorías de gasto); null = sin presupuesto.
  monthlyBudgetCents Int?
  // Categoría de reserva de cada tipo («Otros» / «Otros ingresos»): no se borra y recibe lo huérfano.
  isFallback         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  merchantRules MerchantRule[]

  @@unique([userId, name])
  @@map("categories")
}

// Movimiento (gasto o ingreso). El nombre del modelo se mantiene por compatibilidad con la colección.
model Expense {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  categoryId    String        @db.ObjectId
  kind          EntryKind     @default(EXPENSE)
  // Dinero siempre en céntimos enteros y positivos; el signo lo da el campo kind.
  amountCents   Int
  currency      String        @default("EUR")
  description   String
  merchant      String?
  date          DateTime
  source        ExpenseSource @default(MANUAL)
  // Id de la transacción en el banco (Tink) para deduplicar importaciones.
  externalId    String?
  categorizedBy CategorizedBy @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, externalId])
  @@map("expenses")
}

// Regla aprendida cuando el usuario corrige la categoría de un comercio.
model MerchantRule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  // Comercio normalizado (minúsculas, sin espacios dobles).
  merchantKey String
  categoryId  String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@map("merchant_rules")
}

// Caché de insights de IA: uno por usuario y tipo, válido 24 h o hasta que cambien los datos.
model AiInsight {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  kind      InsightKind
  // Hash del resumen enviado a Claude: si los datos cambian, el hash cambia.
  dataHash  String
  payload   Json
  model     String
  stale     Boolean     @default(false)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("ai_insights")
}

// Contadores de cuota por usuario y periodo (YYYY-MM).
model UsageCounter {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  period     String
  // Transacciones creadas (manuales + importadas) en el periodo.
  expenses   Int      @default(0)
  // Llamadas de IA de insights en el periodo.
  aiInsights Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("usage_counters")
}
